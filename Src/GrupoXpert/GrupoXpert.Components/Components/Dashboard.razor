@using GrupoXpert.Core.Models

<div class="dashboard-container">
    <h2 class="dashboard-title">Nuestros Servicios</h2>
    
    @if (Servicios == null || !Servicios.Any())
    {
        <div class="loading-container">
            <p>Cargando servicios...</p>
        </div>
    }
    else
    {
        <div class="servicios-grid">
            @foreach (var servicio in Servicios)
            {
                <div class="servicio-card" style="background-color: @servicio.ColorFondo">
                    <div class="servicio-header">
                        @if (!string.IsNullOrEmpty(servicio.Icono))
                        {
                            <i class="@servicio.Icono"></i>
                        }
                        <h3>@servicio.Titulo</h3>
                        @if (servicio.Destacado)
                        {
                            <span class="destacado-badge">Destacado</span>
                        }
                    </div>
                    
                    <div class="servicio-body">
                        <p>@servicio.Descripcion</p>
                        @if (!string.IsNullOrEmpty(servicio.ImagenUrl))
                        {
                            <img src="@servicio.ImagenUrl" alt="@servicio.Titulo" />
                        }
                    </div>
                    
                    <div class="servicio-footer">
                        <a href="@servicio.UrlDestino" class="btn-servicio">Más información</a>
                    </div>
                </div>
            }
        </div>
        
        @if (MostrarFiltros)
        {
            <div class="filtros-container">
                <h4>Filtrar por categoría</h4>
                <div class="categorias-list">
                    <button class="btn-categoria @(CategoriaSeleccionada == null ? "active" : "")" 
                            @onclick="() => FiltrarPorCategoria(null)">
                        Todos
                    </button>
                    @foreach (var categoria in Categorias)
                    {
                        <button class="btn-categoria @(CategoriaSeleccionada == categoria ? "active" : "")" 
                                @onclick="() => FiltrarPorCategoria(categoria)">
                            @categoria
                        </button>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public List<Servicio> Servicios { get; set; }
    
    [Parameter]
    public bool MostrarFiltros { get; set; } = true;
    
    private string CategoriaSeleccionada { get; set; }
    
    private List<string> Categorias => Servicios?
        .Select(s => s.Categoria)
        .Distinct()
        .Where(c => !string.IsNullOrEmpty(c))
        .ToList() ?? new List<string>();
    
    private List<Servicio> ServiciosFiltrados => CategoriaSeleccionada == null 
        ? Servicios 
        : Servicios.Where(s => s.Categoria == CategoriaSeleccionada).ToList();
    
    private void FiltrarPorCategoria(string categoria)
    {
        CategoriaSeleccionada = categoria;
    }
}