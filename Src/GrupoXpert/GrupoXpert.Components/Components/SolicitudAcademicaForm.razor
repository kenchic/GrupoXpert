@using GrupoXpert.Core.Models
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<div class="solicitud-container">
    <MudCard Class="pa-6">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-3" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h4">Solicitud Académica Personalizada</MudText>
                </div>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <EditForm Model="@solicitud" OnValidSubmit="@OnValidSubmit">
                <DataAnnotationsValidator />

                <MudGrid>
                    <!-- Nivel Académico -->
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="solicitud.NivelAcademico"
                                   Label="Nivel Académico"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   For="@(() => solicitud.NivelAcademico)">
                            @foreach (var nivel in NivelesAcademicos.Opciones)
                            {
                                <MudSelectItem Value="@nivel">@nivel</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- Tipo de Trabajo -->
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="solicitud.TipoTrabajo"
                                   Label="Tipo de Trabajo"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   For="@(() => solicitud.TipoTrabajo)">
                            @foreach (var tipo in TiposTrabajos.Opciones)
                            {
                                <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- Área del Conocimiento -->
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="solicitud.AreaConocimiento"
                                   Label="Área del Conocimiento"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   For="@(() => solicitud.AreaConocimiento)">
                            @foreach (var area in AreasConocimiento.Opciones)
                            {
                                <MudSelectItem Value="@area">@area</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- Norma de Citación -->
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="solicitud.NormaCitacion"
                                   Label="Norma de Citación"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   For="@(() => solicitud.NormaCitacion)">
                            @foreach (var norma in NormasCitacion.Opciones)
                            {
                                <MudSelectItem Value="@norma">@norma</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- Tema -->
                    <MudItem xs="12">
                        <MudTextField @bind-Value="solicitud.Tema"
                                      Label="Tema del Trabajo"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Required="true"
                                      Counter="500"
                                      MaxLength="500"
                                      For="@(() => solicitud.Tema)"
                                      HelperText="Describe brevemente el tema o título de tu trabajo" />
                    </MudItem>

                    <!-- Número de Páginas y Palabras -->
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="solicitud.NumeroPaginas"
                                         Label="Número de Páginas"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="10000"
                                         For="@(() => solicitud.NumeroPaginas)"
                                         HelperText="Aproximado" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="solicitud.NumeroPalabras"
                                         Label="Número de Palabras"
                                         Variant="Variant.Outlined"
                                         Min="100"
                                         Max="1000000"
                                         For="@(() => solicitud.NumeroPalabras)"
                                         HelperText="Aproximado" />
                    </MudItem>

                    <!-- Fecha de Entrega -->
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="solicitud.FechaEntrega"
                                       Label="Fecha de Entrega"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       MinDate="DateTime.Today.AddDays(1)"
                                       For="@(() => solicitud.FechaEntrega)" />
                    </MudItem>

                    <!-- Opciones Especiales -->
                    <MudItem xs="12" md="6">
                        <div class="d-flex flex-column gap-2">
                            <MudCheckBox @bind-Value="solicitud.EsUrgente"
                                         Label="Entrega Urgente"
                                         Color="Color.Warning" />
                            <MudCheckBox @bind-Value="solicitud.EntregaPorFases"
                                         Label="Entrega por Fases"
                                         Color="Color.Info" />
                        </div>
                    </MudItem>

                    <!-- Instrucciones -->
                    <MudItem xs="12">
                        <MudTextField @bind-Value="solicitud.Instrucciones"
                                      Label="Instrucciones Adicionales"
                                      Variant="Variant.Outlined"
                                      Lines="5"
                                      HelperText="Proporciona cualquier instrucción específica, requisitos especiales o información adicional" />
                    </MudItem>

                    <!-- Adjuntar Documentos -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Documentos de Apoyo</MudText>
                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       OnFilesChanged="OnInputFileChanged"
                                       Hidden="false"
                                       Class="flex-1"
                                       InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20"
                                       InputStyle="opacity:0"
                                       @ondragenter="@SetDragClass"
                                       @ondragleave="@ClearDragClass"
                                       @ondragover="@SetDragClass">


                        </MudFileUpload>

                        @if (solicitud.DocumentosAdjuntos.Any())
                        {
                            <MudList Class="mt-2" T="string">
                                @foreach (var archivo in solicitud.DocumentosAdjuntos)
                                {
                                    <MudListItem>
                                        <div class="d-flex align-center justify-space-between">
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" />
                                                <MudText>@archivo.Name (@FormatFileSize(archivo.Size))</MudText>
                                            </div>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => RemoveFile(archivo)" />
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-6" />

                <!-- Botones de Acción -->
                <div class="d-flex justify-end gap-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@OnCancelar">
                        Cancelar
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Send"
                               ButtonType="ButtonType.Submit"
                               Disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Enviando...</MudText>
                        }
                        else
                        {
                            <MudText>Enviar Solicitud</MudText>
                        }
                    </MudButton>
                </div>
                <ValidationSummary />
            </EditForm>
        </MudCardContent>


    </MudCard>
</div>

@code {
    [Parameter] public EventCallback<SolicitudAcademica> OnSolicitudEnviada { get; set; }
    [Parameter] public EventCallback OnCancelado { get; set; }

    private SolicitudAcademica solicitud = new();
    private bool isSubmitting = false;
    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    private readonly List<string> _fileNames = new();

    private async Task OnValidSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;

        try
        {
            // Validar que al menos uno de los campos de extensión esté lleno
            if (!solicitud.NumeroPaginas.HasValue && !solicitud.NumeroPalabras.HasValue)
            {
                // Mostrar mensaje de error
                return;
            }

            await OnSolicitudEnviada.InvokeAsync(solicitud);

            // Limpiar formulario después del envío exitoso
            solicitud = new SolicitudAcademica();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnCancelar()
    {
        await OnCancelado.InvokeAsync();
    }

    private void OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();
        var files = e.GetMultipleFiles();

        foreach (var file in files)
        {
            // Validar tamaño del archivo (máximo 10MB)
            if (file.Size <= 10 * 1024 * 1024)
            {
                solicitud.DocumentosAdjuntos.Add(file);
            }
        }
    }

    private void RemoveFile(IBrowserFile file)
    {
        solicitud.DocumentosAdjuntos.Remove(file);
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }
}