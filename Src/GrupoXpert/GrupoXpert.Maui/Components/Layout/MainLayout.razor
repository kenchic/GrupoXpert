@inherits LayoutComponentBase

@* === MOBILE TOP BAR === *@
<div class="gx-mobile-topbar">
    <img class="gx-mobile-topbar-avatar" src="images/logo.jpg" alt="Perfil" />
    <input class="gx-mobile-topbar-search" type="text" placeholder="Buscar en GrupoXpert..." />
    <button class="gx-mobile-topbar-action">
        <span class="material-icons">chat_bubble_outline</span>
    </button>
</div>

@* === SCROLLABLE CONTENT === *@
<div class="gx-mobile-content">
    @Body
</div>

@* === BOTTOM TAB BAR (estilo LinkedIn móvil) === *@
<nav class="gx-tab-bar">
    <a href="/" class="gx-tab-item @(EsRutaActiva("/") ? "active" : "")">
        <span class="material-icons">home</span>
        <span>Inicio</span>
    </a>
    <a href="/academia" class="gx-tab-item @(EsRutaActiva("/academia") ? "active" : "")">
        <span class="material-icons">school</span>
        <span>Academia</span>
    </a>
    <a class="gx-tab-item gx-tab-item-create">
        <span class="material-icons">add</span>
        <span>Publicar</span>
    </a>
    <a href="/notificaciones" class="gx-tab-item @(EsRutaActiva("/notificaciones") ? "active" : "")">
        <span class="material-icons">notifications</span>
        <span>Avisos</span>
    </a>
    <a href="/perfil" class="gx-tab-item @(EsRutaActiva("/perfil") ? "active" : "")">
        <span class="material-icons">person</span>
        <span>Perfil</span>
    </a>
</nav>

<RadzenComponents />

@code {
    [Inject] private NavigationManager Navegacion { get; set; } = default!;

    private bool EsRutaActiva(string ruta)
    {
        var rutaActual = new Uri(Navegacion.Uri).AbsolutePath;
        if (ruta == "/") return rutaActual == "/";
        return rutaActual.StartsWith(ruta, StringComparison.OrdinalIgnoreCase);
    }
}
