    // JWT MANUAL DECODERS
    private string ObtenerRolDelToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length > 1)
            {
                var payload = parts[1];
                payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
                var bytes = Convert.FromBase64String(payload);
                var json = System.Text.Encoding.UTF8.GetString(bytes);
                using var doc = System.Text.Json.JsonDocument.Parse(json);

                if (doc.RootElement.TryGetProperty("role", out var roleProp))
                {
                    return roleProp.GetString() ?? "Estudiante";
                }
                if (doc.RootElement.TryGetProperty("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out var rolePropXml))
                {
                    return rolePropXml.GetString() ?? "Estudiante";
                }
            }
        }
        catch { }
        return "Estudiante";
    }

    private Guid ObtenerUsuarioIdDelToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length > 1)
            {
                var payload = parts[1];
                payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
                var bytes = Convert.FromBase64String(payload);
                var json = System.Text.Encoding.UTF8.GetString(bytes);
                using var doc = System.Text.Json.JsonDocument.Parse(json);

                if (doc.RootElement.TryGetProperty("sub", out var subProp) && Guid.TryParse(subProp.GetString(), out var subId))
                {
                    return subId;
                }
                if (doc.RootElement.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier", out var nameIdProp) && Guid.TryParse(nameIdProp.GetString(), out var nameId))
                {
                    return nameId;
                }
            }
        }
        catch { }
        return Guid.Empty;
    }

    private string ObtenerInicialesNombre(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "CO";
        var parts = nombre.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "CO";
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
        return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[parts.Length - 1][0])}";
    }

