    private async Task GuardarAsignacion()
    {
        if (!Guid.TryParse(asesorSeleccionadoIdString, out var asesorId) || asesorId == Guid.Empty)
        {
            mensajeError = "Por favor seleccione un asesor.";
            Notificaciones.Notify(NotificationSeverity.Warning, "Selección requerida", mensajeError, 4000);
            return;
        }

        guardando = true;
        mensajeError = "";
        mensajeExito = "";

        try
        {
            var perfil = await PerfilColaboradorService.ObtenerPerfilColaboradorAsync(asesorId);
            if (perfil == null)
            {
                mensajeError = "No se encontró el perfil profesional del asesor seleccionado.";
                Notificaciones.Notify(NotificationSeverity.Error, "Error de Perfil", mensajeError, 5000);
                return;
            }

            var exito = await SolicitudService.AsignarAsesorAsync(Id, perfil.Id);
            if (exito)
            {
                mensajeExito = "¡Asesor asignado exitosamente!";
                Notificaciones.Notify(NotificationSeverity.Success, "Asignación Exitosa", mensajeExito, 4000);
                solicitud = await SolicitudService.ObtenerPorIdAsync(Id);
            }
            else
            {
                mensajeError = "Ocurrió un error en el servidor al intentar asignar el asesor.";
                Notificaciones.Notify(NotificationSeverity.Error, "Error de Servidor", mensajeError, 5000);
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
            Notificaciones.Notify(NotificationSeverity.Error, "Error Inesperado", mensajeError, 5000);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Postularme()
    {
        if (perfilColaboradorActual == null)
        {
            mensajeError = "No se pudo obtener tu perfil profesional. Por favor, completa tu perfil antes de postularte.";
