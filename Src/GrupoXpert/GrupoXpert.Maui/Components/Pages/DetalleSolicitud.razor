    private string ObtenerFondoGradiente(Guid id)
    {
        var hash = id.GetHashCode();
        var num = Math.Abs(hash) % 4;
        return num switch
        {
            0 => "linear-gradient(135deg, #a62677 0%, #6b2d5c 100%)",
            1 => "linear-gradient(135deg, #4a76b2 0%, #2f5485 100%)",
            2 => "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
            _ => "linear-gradient(135deg, #10b981 0%, #047857 100%)"
        };
    }

