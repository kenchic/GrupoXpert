@page "/"
@inject NavigationManager Navegador
@inject GrupoXpert.Shared.UI.Abstracciones.ISolicitudAcademicaService SolicitudService
@using Microsoft.Maui.Storage
@using GrupoXpert.Shared.UI.Modelos.Academia

<div class="gx-mobile-content-container" style="padding-bottom: env(safe-area-inset-bottom, 32px);">
    @* === Sección de Solicitudes === *@
    
    @if (estaCargando)
    {
        @* Skeleton loader for mobile *@
        <div class="gx-card" style="padding: 16px; margin-bottom: 12px; background: white;">
            <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: #e5e7eb; animation: pulse 1.5s infinite ease-in-out;"></div>
                <div style="flex: 1;">
                    <div style="width: 120px; height: 14px; background: #e5e7eb; margin-bottom: 6px; border-radius: 4px; animation: pulse 1.5s infinite ease-in-out;"></div>
                    <div style="width: 80px; height: 10px; background: #e5e7eb; border-radius: 4px; animation: pulse 1.5s infinite ease-in-out;"></div>
                </div>
            </div>
            <div style="width: 100%; height: 40px; background: #f3f4f6; border-radius: 6px; animation: pulse 1.5s infinite ease-in-out;"></div>
        </div>

    }
    else if (solicitudes == null || !solicitudes.Any())
    {
        @* Premium empty state for mobile *@
        <div class="gx-card" style="padding: 32px 16px; text-align: center; background: white; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 200px; margin-bottom: 16px;">
            <div style="width: 60px; height: 60px; border-radius: 50%; background: var(--color-primario-light); display: flex; align-items: center; justify-content: center; color: var(--color-primario);">
                <span class="material-icons" style="font-size: 2.2rem;">inbox</span>
            </div>
            <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--color-texto); margin: 0;">Sin solicitudes registradas</h3>
            <p style="font-size: 0.8rem; color: var(--text-secondary); max-width: 320px; margin: 0; line-height: 1.4;">
                @(rolUsuario == "Estudiante" 
                    ? "Aún no tienes solicitudes académicas registradas en tu cuenta." 
                    : rolUsuario == "Asesor"
                    ? "No tienes solicitudes pendientes de asignación o asignadas actualmente."
                    : "No se registran solicitudes pendientes o en proceso en la plataforma.")
            </p>
        </div>
    }
    else
    {
        @* Feed de solicitudes académicas en móvil *@
        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px;">
            @foreach (var sol in solicitudes)
            {
                <div class="gx-card" style="position: relative; padding: 16px; transition: all var(--transition-medium); border-left: 4px solid @ObtenerBordePorEstado(sol.Estado); background: white; cursor: pointer;" @onclick='() => Navegador.NavigateTo($"/solicitud-academica/{sol.Id}")'>
                    @* Pulsing urgent badge *@
                    @if (sol.EsUrgente)
                    {
                        <div class="gx-urgente-badge-mobile">
                            <span class="material-icons" style="font-size: 0.8rem;">priority_high</span>
                            <span>URGENTE</span>
                        </div>
                    }

                    <div style="border-bottom: 1px solid var(--divider); padding-bottom: 10px; display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
                        <div style="display: flex; gap: 10px; align-items: center; max-width: 70%;">
                            <div style="width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: @ObtenerFondoGradiente(sol.Id); color: white; font-weight: 800; font-size: 1rem; box-shadow: 0 3px 6px rgba(0,0,0,0.1); flex-shrink: 0;">
                                @ObtenerInicialesArea(sol.AreaTematica)
                            </div>
                            <div style="min-width: 0;">
                                <div style="font-size: 0.92rem; font-weight: 700; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @sol.AreaTematica
                                </div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @ObtenerNivelAcademicoTexto(sol.NivelAcademico) • @ObtenerTipoTrabajoTexto(sol.TipoTrabajo)
                                </div>
                            </div>
                        </div>
                        
                        @* State Badge *@
                        <span class="gx-badge-estado-mobile" style="background: @ObtenerFondoEstado(sol.Estado); color: @ObtenerColorTextoEstado(sol.Estado);">
                            <span class="material-icons" style="font-size: 0.8rem;">@ObtenerIconoEstado(sol.Estado)</span>
                            <span style="font-size: 0.72rem; font-weight: 700;">@ObtenerTextoEstado(sol.Estado)</span>
                        </span>
                    </div>

                    <div style="font-size: 0.84rem; line-height: 1.5; color: var(--text-primary);">
                        @* Mobile optimized grid *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; margin-bottom: 10px;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span class="material-icons" style="color: var(--text-muted); font-size: 1.05rem;">auto_stories</span>
                                <span style="font-size: 0.8rem;">@sol.NumeroPaginasOPalabras págs</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span class="material-icons" style="color: var(--text-muted); font-size: 1.05rem;">format_quote</span>
                                <span style="font-size: 0.8rem;">Citación: @ObtenerNormaCitacionTexto(sol.NormaCitacion)</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span class="material-icons" style="color: var(--text-muted); font-size: 1.05rem;">language</span>
                                <span style="font-size: 0.8rem;">@ObtenerIdiomaTexto(sol.Idioma)</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span class="material-icons" style="color: var(--text-muted); font-size: 1.05rem;">event</span>
                                <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-primario);">@sol.FechaEntrega.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        @* Formato Requerido (Mobile Collapsed-looking box) *@
                        @if (!string.IsNullOrEmpty(sol.FormatoRequerido))
                        {
                            <div style="margin-bottom: 8px; background: #fafafa; border-radius: 4px; padding: 6px 10px; border: 1px dashed var(--divider); font-size: 0.78rem;">
                                <span style="font-weight: 600; color: var(--text-secondary);">Formato:</span> @sol.FormatoRequerido
                            </div>
                        }

                        @* Material base *@
                        @if (!string.IsNullOrEmpty(sol.MaterialBase))
                        {
                            <div style="background: rgba(74, 118, 178, 0.04); border-left: 2.5px solid var(--color-secundario); padding: 6px 10px; border-radius: 0 4px 4px 0; margin-bottom: 8px; font-size: 0.78rem; font-style: italic;">
                                @sol.MaterialBase
                            </div>
                        }

                        @* Small footer chips *@
                        <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; border-top: 1px solid var(--divider); padding-top: 8px;">
                            @if (sol.EntregaPorFases)
                            {
                                <span class="gx-chip-mobile">
                                    <span class="material-icons" style="font-size: 0.75rem;">published_with_changes</span>
                                    <span>Fases</span>
                                </span>
                            }
                            @if (sol.AsesorId != null)
                            {
                                <span class="gx-chip-mobile gx-chip-success-mobile">
                                    <span class="material-icons" style="font-size: 0.75rem;">assignment_ind</span>
                                    <span>Asesorado</span>
                                </span>
                            }
                            else
                            {
                                <span class="gx-chip-mobile gx-chip-warning-mobile">
                                    <span class="material-icons" style="font-size: 0.75rem;">person_search</span>
                                    <span>Buscando asesor</span>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code {
    private string nombreUsuario = "Usuario";
    private string rolUsuario = "Estudiante";
    private bool estaCargando = true;
    private IReadOnlyList<SolicitudAcademicaDto> solicitudes = new List<SolicitudAcademicaDto>();

    protected override async Task OnInitializedAsync()
    {
        var token = Preferences.Default.Get("authToken", string.Empty);
        if (string.IsNullOrEmpty(token))
        {
            Navegador.NavigateTo("/login");
            return;
        }

        try
        {
            nombreUsuario = ObtenerNombreDelToken(token);
            rolUsuario = ObtenerRolDelToken(token);

            // Cargar solicitudes desde el servicio
            solicitudes = await SolicitudService.ObtenerSolicitudesDashboardAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el dashboard MAUI: {ex.Message}");
        }
        finally
        {
            estaCargando = false;
        }
    }

    // JWT MANUAL DECODERS FOR ROBUST MOBILE CAPABILITY
    private string ObtenerRolDelToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length > 1)
            {
                var payload = parts[1];
                payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
                var bytes = Convert.FromBase64String(payload);
                var json = System.Text.Encoding.UTF8.GetString(bytes);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                
                if (doc.RootElement.TryGetProperty("role", out var roleProp))
                {
                    return roleProp.GetString() ?? "Estudiante";
                }
                if (doc.RootElement.TryGetProperty("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out var rolePropXml))
                {
                    return rolePropXml.GetString() ?? "Estudiante";
                }
            }
        }
        catch
        {
            // ignored
        }
        return "Estudiante";
    }

    private string ObtenerNombreDelToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length > 1)
            {
                var payload = parts[1];
                payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
                var bytes = Convert.FromBase64String(payload);
                var json = System.Text.Encoding.UTF8.GetString(bytes);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                
                if (doc.RootElement.TryGetProperty("nombre", out var nameProp))
                {
                    return nameProp.GetString() ?? "Usuario";
                }
                if (doc.RootElement.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name", out var namePropXml))
                {
                    return namePropXml.GetString() ?? "Usuario";
                }
            }
        }
        catch
        {
            // ignored
        }
        return "Usuario";
    }

    // UTILS
    private string ObtenerBordePorEstado(int estado) => estado switch
    {
        1 => "#d97706",
        2 => "#4a76b2",
        3 => "#26b050",
        4 => "#9ca3af",
        5 => "#7c3aed",
        _ => "#e5e7eb"
    };

    private string ObtenerFondoEstado(int estado) => estado switch
    {
        1 => "rgba(245, 158, 11, 0.08)",
        2 => "rgba(74, 118, 178, 0.08)",
        3 => "rgba(38, 176, 80, 0.08)",
        4 => "rgba(156, 163, 175, 0.08)",
        5 => "rgba(124, 58, 237, 0.08)",
        _ => "#f3f4f6"
    };

    private string ObtenerColorTextoEstado(int estado) => estado switch
    {
        1 => "#d97706",
        2 => "#4a76b2",
        3 => "#26b050",
        4 => "#4b5563",
        5 => "#7c3aed",
        _ => "#6b7280"
    };

    private string ObtenerTextoEstado(int estado) => estado switch
    {
        1 => "Pendiente",
        2 => "En Proceso",
        3 => "Completada",
        4 => "Cancelada",
        5 => "Asignada",
        _ => "Desconocido"
    };

    private string ObtenerIconoEstado(int estado) => estado switch
    {
        1 => "pending_actions",
        2 => "engineering",
        3 => "task_alt",
        4 => "cancel",
        5 => "assignment_ind",
        _ => "help_outline"
    };

    private string ObtenerInicialesArea(string area)
    {
        if (string.IsNullOrWhiteSpace(area)) return "SA";
        var parts = area.Split(new[] { ' ', '/', ',' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "SA";
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
        return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
    }

    private string ObtenerFondoGradiente(Guid id)
    {
        var hash = id.GetHashCode();
        var num = Math.Abs(hash) % 4;
        return num switch
        {
            0 => "linear-gradient(135deg, #a62677 0%, #6b2d5c 100%)",
            1 => "linear-gradient(135deg, #4a76b2 0%, #2f5485 100%)",
            2 => "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
            _ => "linear-gradient(135deg, #10b981 0%, #047857 100%)"
        };
    }

    private string ObtenerNivelAcademicoTexto(int nivel) => nivel switch
    {
        0 => "Secundaria",
        1 => "Pregrado",
        2 => "Especialización",
        3 => "Maestría",
        4 => "Doctorado",
        _ => "Desconocido"
    };

    private string ObtenerTipoTrabajoTexto(int tipo) => tipo switch
    {
        0 => "Ensayo",
        1 => "Tesis",
        2 => "Artículo",
        3 => "Monografía",
        4 => "Proyecto de Grado",
        5 => "Resumen",
        6 => "Presentación",
        _ => "Otro"
    };

    private string ObtenerNormaCitacionTexto(int norma) => norma switch
    {
        0 => "APA",
        1 => "IEEE",
        2 => "Vancouver",
        3 => "Chicago",
        4 => "Harvard",
        _ => "Otra"
    };

    private string ObtenerIdiomaTexto(int idioma) => idioma switch
    {
        0 => "Español",
        1 => "Inglés",
        2 => "Portugués",
        3 => "Francés",
        _ => "Otro"
    };
}
