@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using GrupoXpert.Shared.UI.Abstracciones
@using GrupoXpert.Shared.UI.Modelos.Academia
@using GrupoXpert.Shared.UI.Modelos.Calidad
@inject ISolicitudAcademicaService SolicitudService
@inject IRevisionCalidadService RevisionCalidadService
@inject NotificationService Notificaciones
@inject IDescargadorArchivos Descargador
@inject HttpClient Http
@inject DialogService DialogoService

<div class="gx-card" style="padding: 8px; border-radius: 10px; margin-top: 12px;">
    <h3 style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin: 0 0 6px 0; display: flex; align-items: center; gap: 4px;">
        <span class="material-icons" style="font-size: 0.9rem; color: var(--color-primario);">assignment_turned_in</span>
        <span>Avances y Entregables (@avances.Count)</span>
    </h3>

    @* FORMULARIO SUBIR AVANCE (solo asesor asignado) *@
    @if (EsAsesor && SolicitudAsesorId == PerfilColaboradorId)
    {
        <RadzenTemplateForm TItem="ModeloAvance" Data="@modeloNuevoAvance" Submit="@ManejarSubirAvance">
            <RadzenRow Gap="0.25rem">
                <RadzenColumn Size="4">
                    <RadzenFormField Text="Fase #" Variant="Variant.Outlined">
                        <RadzenNumeric @bind-Value="modeloNuevoAvance.NumeroFase"
                                       Name="NumeroFase"
                                       Min="1"
                                       Style="font-size: 0.75rem; height:2rem;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenFormField Text="Tipo" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenDropDown TValue="int" @bind-Value="modeloNuevoAvance.Tipo"
                                        Name="Tipo"
                                        Data="@tiposAvance"
                                        TextProperty="Texto"
                                        ValueProperty="Id"
                                        Style="font-size: 0.75rem; height:2rem;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="0.25rem" class="rz-align-items-center">
                <RadzenColumn Size="12">
                    <RadzenTextArea @bind-Value="modeloNuevoAvance.Descripcion"
                                    Name="Descripcion"
                                    Rows="5"
                                    Placeholder="Descripcion..."
                                    Style="width: 100%; font-size: 0.75rem; min-height: 32px; line-height: 1.2; resize: none; margin-top:2px;" />
                </RadzenColumn>
                    
            </RadzenRow>
            <RadzenRow Gap="0.25rem">
                <RadzenColumn Size="8">
                    <div style="display: flex; align-items: center; gap: 6px; font-size: 0.7rem; color: var(--text-secondary);">
                        <InputFile OnChange="@CargarArchivos" multiple id="inputFileAvance" style="display: none;" />
                        <label for="inputFileAvance" style="cursor: pointer; display: inline-flex; align-items: center; gap: 3px; color: var(--color-primario); font-weight: 600;">
                            <span class="material-icons" style="font-size: 0.8rem;">attach_file</span>
                            <span>Adjuntar</span>
                        </label>
                        @if (archivosSeleccionados.Count > 0)
                        {
                            <span style="color: var(--text-muted);">
                                @archivosSeleccionados.Count archivo@(archivosSeleccionados.Count > 1 ? "s" : ""):
                                @string.Join(", ", archivosSeleccionados.Select(a => a.Name))
                            </span>
                        }
                    </div>
                </RadzenColumn>
                <RadzenColumn Size="4" class="rz-text-align-right">
                    <RadzenButton Text="Subir"
                                  Icon="cloud_upload"
                                  ButtonStyle="ButtonStyle.Primary"
                                  ButtonType="ButtonType.Submit"
                                  IsBusy="@subiendoAvance"
                                  Size="ButtonSize.Small"
                                  Style="font-weight: 700; border-radius: 6px; font-size: 0.7rem; width: 100%; padding: 4px 6px; margin-top: 4px;" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenTemplateForm>
    }

    @* LISTA DE AVANCES *@
    @if (estaCargando)
    {
        <div style="text-align: center; padding: 20px; color: var(--text-secondary);">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <p style="margin-top: 8px; font-size: 0.75rem;">Cargando avances...</p>
        </div>
    }
    else if (avances.Count == 0)
    {
        <div style="background: #fafafa; border: 1px dashed var(--divider); border-radius: 8px; padding: 20px 8px; text-align: center;">
            <span class="material-icons" style="font-size: 1.5rem; color: #9ca3af;">inbox</span>
            <p style="font-size: 0.75rem; color: var(--text-secondary); margin: 4px 0 0 0;">
                Sin avances registrados.
            </p>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 10px;">
            @foreach (var avance in avances)
            {
                var estaExpandido = avancesExpandidos.Contains(avance.Id);
                if (!modelosComentario.ContainsKey(avance.Id))
                    modelosComentario[avance.Id] = new ModeloComentario();
                var comentarioModelo = modelosComentario[avance.Id];

                <div class="gx-card" style="padding: 10px; border: 1px solid var(--divider); border-radius: 8px; border-left: 3px solid @ObtenerBordeTipo(avance.Tipo);">
                    @* HEADER *@
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--color-primario-light); display: flex; align-items: center; justify-content: center; color: var(--color-primario); font-weight: 700; font-size: 0.7rem;">
                                @ObtenerIniciales(avance.NombreAsesor)
                            </div>
                            <div>
                                <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-primary); display: block;">
                                    @avance.NombreAsesor
                                </span>
                                <div style="display: flex; align-items: center; gap: 4px; margin-top: 1px; flex-wrap: wrap;">
                                    <span style="font-size: 0.68rem; color: var(--text-secondary);">
                                        Fase #@avance.NumeroFase
                                    </span>
                                    <span style="font-size: 0.6rem; color: #d1d5db;">•</span>
                                    <span class="gx-chip @(avance.Tipo == 2 ? "gx-chip-success" : "gx-chip")" style="font-size: 0.62rem; padding: 1px 5px;">
                                        @(avance.Tipo == 2 ? "Final" : "Parcial")
                                    </span>
                                    <span style="font-size: 0.6rem; color: #d1d5db;">•</span>
                                    <span style="font-size: 0.68rem; color: var(--text-muted);">
                                        @FormatearTiempo(avance.FechaSubida)
                                    </span>
                                </div>
                            </div>
                        </div>
                        <span class="gx-badge-estado" style="background: @ObtenerFondoEstadoAvance(avance.Estado); color: @ObtenerColorTextoEstadoAvance(avance.Estado); padding: 2px 8px; border-radius: 12px; font-size: 0.65rem; font-weight: 700;">
                            <span class="material-icons" style="font-size: 0.7rem; vertical-align: middle;">@ObtenerIconoEstadoAvance(avance.Estado)</span>
                            @ObtenerTextoEstadoAvance(avance.Estado)
                        </span>
                    </div>

                    @* DESCRIPCION *@
                    <p style="font-size: 0.78rem; color: var(--text-primary); line-height: 1.4; margin: 0 0 8px 0; white-space: pre-wrap;">
                        @avance.Descripcion
                    </p>

                    @* ARCHIVOS *@
                    @if (avance.ArchivosAdjuntos.Count > 0)
                    {
                        <div style="background: #f9fafb; border-radius: 6px; padding: 6px 8px; margin-bottom: 6px;">
                            <span style="font-size: 0.7rem; font-weight: 700; color: var(--text-secondary); display: flex; align-items: center; gap: 3px; margin-bottom: 4px;">
                                <span class="material-icons" style="font-size: 0.8rem;">attach_file</span>
                                Archivos (@avance.ArchivosAdjuntos.Count)
                            </span>
                            <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                @foreach (var archivo in avance.ArchivosAdjuntos)
                                {
                                    <span @onclick="() => DescargarArchivo(archivo.Url)" @onclick:stopPropagation="true"
                                          style="display: inline-flex; align-items: center; gap: 4px; background: white; border: 1px solid var(--divider); border-radius: 5px; padding: 3px 8px; color: var(--color-secundario); font-size: 0.7rem; font-weight: 600; cursor: pointer;">
                                        <span class="material-icons" style="font-size: 0.8rem;">description</span>
                                        <span>@archivo.NombreArchivo</span>
                                        <span style="font-size: 0.65rem; color: var(--text-muted);">(@FormatearTamano(archivo.TamanioBytes))</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @* ACCIONES *@
                    <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
                        <RadzenButton Text="@ObtenerTextoBotonComentarios(estaExpandido, avance.Comentarios.Count)"
                                      Icon="@(estaExpandido ? "unfold_less" : "chat_bubble_outline")"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="@(() => AlternarExpansion(avance.Id))"
                                      Style="font-weight: 600; font-size: 0.7rem;" />

                        @if ((EsRevisor || EsAdmin) && avance.Tipo == 2 && avance.Estado == 1)
                        {
                            <RadzenButton Text="Dar Visto Bueno"
                                          Icon="verified"
                                          ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Small"
                                          Click="@(() => DarVistoBueno(avance.Id))"
                                          IsBusy="@(_vistoBuenoEnProgreso == avance.Id)"
                                          Style="font-weight: 600; font-size: 0.7rem;" />
                            <RadzenButton Text="Rechazar"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Click="@(() => AbrirDialogoRechazo(avance))"
                                          Style="font-weight: 600; font-size: 0.7rem;"
                                          Visible="false"/>
                        }


                    </div>

                    @* COMENTARIOS *@
                    @if (estaExpandido)
                    {
                        <div style="border-top: 1px solid var(--divider); margin-top: 6px; padding-top: 6px;">
                            @foreach (var comentario in avance.Comentarios.OrderByDescending(c => c.FechaCreacion))
                            {
                                <div style="display: flex; gap: 6px; margin-bottom: 6px; padding: 6px; background: #f9fafb; border-radius: 5px;">
                                    <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--color-secundario); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.6rem; flex-shrink: 0;">
                                        @ObtenerIniciales(comentario.NombreAutor)
                                    </div>
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 2px;">
                                            <span style="font-size: 0.7rem; font-weight: 700; color: var(--text-primary);">@comentario.NombreAutor</span>
                                            <span style="font-size: 0.62rem; color: var(--text-muted);">@FormatearTiempo(comentario.FechaCreacion)</span>
                                        </div>
                                        <p style="font-size: 0.72rem; color: var(--text-primary); margin: 0; line-height: 1.3; white-space: pre-wrap;">
                                            @comentario.Contenido
                                        </p>
                                    </div>
                                </div>
                            }

                            @* NUEVO COMENTARIO *@
                            <div style="display: flex; gap: 6px; align-items: flex-start; margin-top: 6px;">
                                <RadzenTextArea @bind-Value="comentarioModelo.Contenido"
                                                Name="@($"comentario_{avance.Id}")"
                                                Rows="1"
                                                Placeholder="Escribe un comentario..."
                                                Style="flex: 1; font-size: 0.75rem;" />
                                <RadzenButton Text="Enviar"
                                              Icon="send"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small"
                                              Click="@(() => EnviarComentario(avance.Id, comentarioModelo.Contenido))"
                                              Style="font-weight: 600; font-size: 0.7rem; margin-top: 2px;" />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SolicitudId { get; set; }
    [Parameter] public Guid? SolicitudAsesorId { get; set; }
    [Parameter] public Guid PerfilColaboradorId { get; set; }
    [Parameter] public Guid UsuarioId { get; set; }
    [Parameter] public bool EsAsesor { get; set; }
    [Parameter] public bool EsAdmin { get; set; }
    [Parameter] public bool EsRevisor { get; set; }
    [Parameter] public EventCallback RecargarSolicitud { get; set; }

    private List<AvanceDto> avances = new();
    private bool estaCargando = true;
    private bool subiendoAvance;
    private readonly HashSet<Guid> avancesExpandidos = new();
    private ModeloAvance modeloNuevoAvance = new();
    private Dictionary<Guid, ModeloComentario> modelosComentario = new();
    private List<IBrowserFile> archivosSeleccionados = new();
    private Guid? _vistoBuenoEnProgreso;
    private string _observacionesRechazo = string.Empty;
    private AvanceDto? _avanceARechazar;
    private bool _rechazando;

    private readonly List<OpcionCombo> tiposAvance = new()
    {
        new(1, "Parcial"),
        new(2, "Final")
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarAvances();
    }

    private async Task CargarAvances()
    {
        estaCargando = true;
        try
        {
            var resultado = await SolicitudService.ObtenerAvancesAsync(SolicitudId);
            avances = resultado?.OrderByDescending(a => a.FechaSubida).ToList() ?? new();
        }
        catch
        {
            avances = new();
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }
    }

    private void CargarArchivos(InputFileChangeEventArgs e)
    {
        archivosSeleccionados = e.GetMultipleFiles(maximumFileCount: 5).ToList();
    }

    private async Task ManejarSubirAvance(ModeloAvance modelo)
    {
        if (string.IsNullOrWhiteSpace(modelo.Descripcion))
        {
            Notificaciones.Notify(NotificationSeverity.Warning, "Validacion", "La descripcion del avance es obligatoria.");
            return;
        }

        subiendoAvance = true;
        try
        {
            var archivos = new List<ArchivoSubidaModelo>();
            foreach (var archivo in archivosSeleccionados)
            {
                archivos.Add(new ArchivoSubidaModelo
                {
                    NombreArchivo = archivo.Name,
                    TipoContenido = archivo.ContentType,
                    TamanioBytes = archivo.Size,
                    Contenido = archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)
                });
            }

            var resultado = await SolicitudService.SubirAvanceAsync(
                SolicitudId, PerfilColaboradorId, modelo.Descripcion, modelo.NumeroFase, modelo.Tipo, archivos);

            if (resultado != null)
            {
                Notificaciones.Notify(NotificationSeverity.Success, "Exito", "Avance subido correctamente.");
                modeloNuevoAvance = new ModeloAvance();
                archivosSeleccionados = new();
                await CargarAvances();
                await RecargarSolicitud.InvokeAsync();
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo subir el avance.");
            }
        }
        catch (Exception ex)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            subiendoAvance = false;
        }
    }

    private async Task EnviarComentario(Guid avanceId, string contenido)
    {
        if (string.IsNullOrWhiteSpace(contenido))
        {
            Notificaciones.Notify(NotificationSeverity.Warning, "Validacion", "El comentario no puede estar vacio.");
            return;
        }

        try
        {
            var ok = await SolicitudService.AgregarComentarioAsync(avanceId, UsuarioId, contenido);
            if (ok)
            {
                modelosComentario[avanceId] = new ModeloComentario();
                await CargarAvances();
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo enviar el comentario.");
            }
        }
        catch (Exception ex)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    private void AlternarExpansion(Guid avanceId)
    {
        if (avancesExpandidos.Contains(avanceId))
            avancesExpandidos.Remove(avanceId);
        else
            avancesExpandidos.Add(avanceId);
        StateHasChanged();
    }

    private async Task DescargarArchivo(string urlRelativa)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        var urlAbsoluta = $"{baseUrl}{urlRelativa}";
        await Descargador.DescargarAsync(urlAbsoluta);
    }

    private string ObtenerTextoBotonComentarios(bool expandido, int conteo)
    {
        var prefijo = expandido ? "Ocultar comentarios" : "Comentarios";
        return $"{prefijo} ({conteo})";
    }

    private string ObtenerBordeTipo(int tipo) => tipo == 2 ? "#26b050" : "#4a76b2";

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "??";
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "??";
        if (partes.Length == 1) return partes[0].Length >= 2 ? partes[0][..2].ToUpper() : partes[0].ToUpper();
        return $"{char.ToUpper(partes[0][0])}{char.ToUpper(partes[^1][0])}";
    }

    private string FormatearTiempo(DateTime fecha)
    {
        var diferencia = DateTime.UtcNow - fecha;
        if (diferencia.TotalMinutes < 1) return "Ahora mismo";
        if (diferencia.TotalMinutes < 60) return $"Hace {(int)diferencia.TotalMinutes} min";
        if (diferencia.TotalHours < 24) return $"Hace {(int)diferencia.TotalHours} h";
        if (diferencia.TotalDays < 7) return $"Hace {(int)diferencia.TotalDays} d";
        return fecha.ToString("dd/MM/yyyy");
    }

    private string FormatearTamano(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    private string ObtenerTextoEstadoAvance(int estado) => estado switch
    {
        1 => "Pendiente",
        2 => "Aprobado",
        3 => "Rechazado",
        4 => "Liberado",
        _ => "Desconocido"
    };

    private string ObtenerFondoEstadoAvance(int estado) => estado switch
    {
        1 => "rgba(245, 158, 11, 0.10)",
        2 => "rgba(38, 176, 80, 0.10)",
        3 => "rgba(239, 68, 68, 0.10)",
        4 => "rgba(16, 185, 129, 0.10)",
        _ => "#f3f4f6"
    };

    private string ObtenerColorTextoEstadoAvance(int estado) => estado switch
    {
        1 => "#d97706",
        2 => "#26b050",
        3 => "#ef4444",
        4 => "#10b981",
        _ => "#6b7280"
    };

    private string ObtenerIconoEstadoAvance(int estado) => estado switch
    {
        1 => "pending",
        2 => "check_circle",
        3 => "cancel",
        4 => "verified",
        _ => "help_outline"
    };

    private async Task DarVistoBueno(Guid avanceId)
    {
        _vistoBuenoEnProgreso = avanceId;
        try
        {
            var revisionExistente = await RevisionCalidadService.ObtenerPorAvanceAsync(avanceId);
            Guid revisionId;

            if (revisionExistente != null)
            {
                revisionId = revisionExistente.Id;
            }
            else
            {
                var nuevaRevision = await RevisionCalidadService.CrearRevisionAsync(avanceId, UsuarioId);
                if (nuevaRevision == null)
                {
                    Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo crear la revision.");
                    return;
                }
                revisionId = nuevaRevision.Id;
            }

            var resultado = await RevisionCalidadService.OtorgarVistoBuenoAsync(revisionId);
            if (resultado != null)
            {
                Notificaciones.Notify(NotificationSeverity.Success, "Visto Bueno", "Se otorgo el visto bueno correctamente.");
                await CargarAvances();
                await RecargarSolicitud.InvokeAsync();
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo otorgar el visto bueno.");
            }
        }
        catch (Exception ex)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            _vistoBuenoEnProgreso = null;
        }
    }

    private async Task AbrirDialogoRechazo(AvanceDto avance)
    {
        _avanceARechazar = avance;
        _observacionesRechazo = string.Empty;

        RenderFragment<DialogService> contenido = ds => builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "style", "display: flex; flex-direction: column; gap: 1rem; min-width: 400px;");

            builder.OpenElement(2, "p");
            builder.AddAttribute(3, "style", "margin: 0; font-size: 0.9rem;");
            builder.AddContent(4, "Describe el motivo del rechazo para que el asesor pueda corregir el documento:");
            builder.CloseElement();

            builder.OpenComponent<RadzenTextArea>(5);
            builder.AddAttribute(6, "Value", _observacionesRechazo);
            builder.AddAttribute(7, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _observacionesRechazo = v));
            builder.AddAttribute(8, "Rows", 4);
            builder.AddAttribute(9, "Placeholder", "Escribe las observaciones del rechazo...");
            builder.AddAttribute(10, "Style", "width: 100%;");
            builder.CloseComponent();

            builder.OpenElement(11, "div");
            builder.AddAttribute(12, "style", "display: flex; gap: 0.5rem; justify-content: flex-end; padding-top: 0.5rem;");

            builder.OpenComponent<RadzenButton>(13);
            builder.AddAttribute(14, "Text", "Cancelar");
            builder.AddAttribute(15, "ButtonStyle", ButtonStyle.Secondary);
            builder.AddAttribute(16, "Click", EventCallback.Factory.Create(this, () => ds.Close(false)));
            builder.CloseComponent();

            builder.OpenComponent<RadzenButton>(17);
            builder.AddAttribute(18, "Text", "Confirmar Rechazo");
            builder.AddAttribute(19, "ButtonStyle", ButtonStyle.Danger);
            builder.AddAttribute(20, "Disabled", string.IsNullOrWhiteSpace(_observacionesRechazo));
            builder.AddAttribute(21, "Click", EventCallback.Factory.Create(this, () => ds.Close(true)));
            builder.CloseComponent();

            builder.CloseElement();
            builder.CloseElement();
        };

        var resultadoObj = await DialogoService.OpenAsync("Rechazar Revision", contenido);
        if (resultadoObj is true)
            await ConfirmarRechazo();
    }

    private async Task ConfirmarRechazo()
    {
        if (_avanceARechazar == null || string.IsNullOrWhiteSpace(_observacionesRechazo)) return;

        _rechazando = true;
        try
        {
            var revisionExistente = await RevisionCalidadService.ObtenerPorAvanceAsync(_avanceARechazar.Id);
            Guid revisionId;

            if (revisionExistente != null)
            {
                revisionId = revisionExistente.Id;
            }
            else
            {
                var nuevaRevision = await RevisionCalidadService.CrearRevisionAsync(_avanceARechazar.Id, UsuarioId);
                if (nuevaRevision == null)
                {
                    Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo crear la revision.");
                    return;
                }
                revisionId = nuevaRevision.Id;
            }

            var resultado = await RevisionCalidadService.RechazarRevisionAsync(revisionId, _observacionesRechazo);
            if (resultado != null)
            {
                Notificaciones.Notify(NotificationSeverity.Success, "Rechazado", "Se rechazo la revision correctamente.");
                await CargarAvances();
                await RecargarSolicitud.InvokeAsync();
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo rechazar la revision.");
            }
        }
        catch (Exception ex)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            _rechazando = false;
            _avanceARechazar = null;
            _observacionesRechazo = string.Empty;
        }
    }

    private class ModeloAvance
    {
        public string Descripcion { get; set; } = string.Empty;
        public int NumeroFase { get; set; } = 1;
        public int Tipo { get; set; } = 1;
    }

    private class ModeloComentario
    {
        public string Contenido { get; set; } = string.Empty;
    }

    private record OpcionCombo(int Id, string Texto);
}
