@using Radzen
@using Radzen.Blazor
@using GrupoXpert.Shared.UI.Modelos
@using GrupoXpert.Shared.UI.Abstracciones

@inject IAdminService AdminService
@inject NotificationService Notificaciones
@inject DialogService Dialogo

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Gestión de Colaboradores (Asesores)</RadzenText>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span">Estado de Aprobación:</RadzenText>
            <RadzenDropDown @bind-Value="filtroAprobado" 
                            Data="@estadosAprobacion" 
                            TextProperty="Text" 
                            ValueProperty="Value" 
                            Change="@(args => CargarUsuariosAsync())" 
                            Style="width: 200px" />
            
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span">Estado de Verificación:</RadzenText>
            <RadzenDropDown @bind-Value="filtroEstadoVerificacion" 
                            Data="@estadosVerificacion" 
                            TextProperty="Text" 
                            ValueProperty="Value" 
                            Change="@(args => CargarUsuariosAsync())" 
                            Style="width: 200px" />
        </RadzenStack>
    </RadzenCard>

    <RadzenDataGrid @ref="grid"
                    Data="@usuarios"
                    Count="@totalRegistros"
                    LoadData="@CargarDatosGridAsync"
                    TItem="UsuarioListaDto"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="false"
                    AllowFiltering="false"
                    IsLoading="@estaCargando"
                    class="tabla-gestion-usuarios">
        <Columns>
            <RadzenDataGridColumn TItem="UsuarioListaDto" Property="Nombre" Title="Nombre" />
            <RadzenDataGridColumn TItem="UsuarioListaDto" Property="Correo" Title="Correo Electrónico" />
            <RadzenDataGridColumn TItem="UsuarioListaDto" Property="FechaCreacion" Title="Fecha Registro">
                <Template Context="usuario">
                    @usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UsuarioListaDto" Title="Estado Cuenta" Width="120px">
                <Template Context="usuario">
                    @if (usuario.EstaActivo)
                    {
                        <RadzenBadge Text="Activa" BadgeStyle="BadgeStyle.Success" />
                    }
                    else
                    {
                        <RadzenBadge Text="Inactiva" BadgeStyle="BadgeStyle.Light" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UsuarioListaDto" Title="Verificación" Width="140px">
                <Template Context="usuario">
                    @switch (usuario.EstadoVerificacion)
                    {
                        case EstadoVerificacionUI.Pendiente:
                            <RadzenBadge Text="Pendiente" BadgeStyle="BadgeStyle.Warning" />
                            break;
                        case EstadoVerificacionUI.EnRevision:
                            <RadzenBadge Text="En Revisión" BadgeStyle="BadgeStyle.Info" />
                            break;
                        case EstadoVerificacionUI.Aprobado:
                            <RadzenBadge Text="Aprobado" BadgeStyle="BadgeStyle.Success" />
                            break;
                        case EstadoVerificacionUI.Rechazado:
                            <RadzenBadge Text="Rechazado" BadgeStyle="BadgeStyle.Danger" />
                            break;
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UsuarioListaDto" Title="Aprobación" Width="120px">
                <Template Context="usuario">
                    @if (usuario.EstaAprobado)
                    {
                        <RadzenBadge Text="Aprobado" BadgeStyle="BadgeStyle.Info" />
                    }
                    else
                    {
                        <RadzenBadge Text="Pendiente" BadgeStyle="BadgeStyle.Warning" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UsuarioListaDto" Title="Acciones" Width="200px" TextAlign="TextAlign.Center">
                <Template Context="usuario">
                    @if (usuario.EstadoVerificacion == EstadoVerificacionUI.Pendiente)
                    {
                        <RadzenButton Icon="fact_check" 
                                      Text="Validar Perfil" 
                                      ButtonStyle="ButtonStyle.Info" 
                                      Size="ButtonSize.Small"
                                      Click="@(() => ConfirmarValidacionPerfilAsync(usuario))" />
                    }
                    @if (!usuario.EstaAprobado)
                    {
                        <RadzenButton Icon="check_circle" 
                                      Text="Aprobar" 
                                      ButtonStyle="ButtonStyle.Success" 
                                      Size="ButtonSize.Small"
                                      Click="@(() => ConfirmarAprobacionAsync(usuario))" />
                    }
                    else
                    {
                        <RadzenButton Icon="cancel" 
                                      Text="Revocar" 
                                      ButtonStyle="ButtonStyle.Danger" 
                                      Size="ButtonSize.Small"
                                      Click="@(() => ConfirmarRevocacionAsync(usuario))" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    private RadzenDataGrid<UsuarioListaDto> grid = default!;
    private IEnumerable<UsuarioListaDto> usuarios = new List<UsuarioListaDto>();
    private int totalRegistros = 0;
    private bool estaCargando = false;
    private int paginaActual = 1;
    private int tamanoPagina = 10;

    // Filtros
    private bool? filtroAprobado = null;
    private int? filtroEstadoVerificacion = null;
    
    private readonly IEnumerable<object> estadosAprobacion = new List<object>
    {
        new { Text = "Todos", Value = (bool?)null },
        new { Text = "Pendientes", Value = (bool?)false },
        new { Text = "Aprobados", Value = (bool?)true }
    };

    private readonly IEnumerable<object> estadosVerificacion = new List<object>
    {
        new { Text = "Todos", Value = (int?)null },
        new { Text = "Pendientes", Value = (int?)EstadoVerificacionUI.Pendiente },
        new { Text = "En Revisión", Value = (int?)EstadoVerificacionUI.EnRevision },
        new { Text = "Aprobados", Value = (int?)EstadoVerificacionUI.Aprobado },
        new { Text = "Rechazados", Value = (int?)EstadoVerificacionUI.Rechazado }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuariosAsync();
    }

    private async Task CargarDatosGridAsync(LoadDataArgs args)
    {
        paginaActual = (args.Skip ?? 0) / (args.Top ?? 10) + 1;
        tamanoPagina = args.Top ?? 10;
        await CargarUsuariosAsync();
    }

    private async Task CargarUsuariosAsync()
    {
        try
        {
            estaCargando = true;
            var resultado = await AdminService.ObtenerUsuariosPaginadoAsync(
                tipo: (int)TipoUsuarioUI.Asesor, 
                estaAprobado: filtroAprobado, 
                estadoVerificacion: filtroEstadoVerificacion,
                pagina: paginaActual, 
                tamanoPagina: tamanoPagina);
            usuarios = resultado.Elementos;
            totalRegistros = resultado.TotalRegistros;
        }
        catch (Exception)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudieron cargar los usuarios.");
        }
        finally
        {
            estaCargando = false;
        }
    }

    private async Task ConfirmarValidacionPerfilAsync(UsuarioListaDto usuario)
    {
        var confirmado = await Dialogo.Confirm(
            $"¿Desea validar el perfil del colaborador {usuario.Nombre}? Esto cambiará el estado a 'En Revisión'.",
            "Validar Perfil",
            new ConfirmOptions { OkButtonText = "Sí, validar", CancelButtonText = "Cancelar" });

        if (confirmado == true)
        {
            await EjecutarValidacionPerfilAsync(usuario.Id);
        }
    }

    private async Task EjecutarValidacionPerfilAsync(Guid id)
    {
        try
        {
            estaCargando = true;
            var exito = await AdminService.ValidarPerfilColaboradorAsync(id);
            if (exito)
            {
                Notificaciones.Notify(NotificationSeverity.Success, "Éxito", "El perfil ha sido enviado a validación.");
                await CargarUsuariosAsync();
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo validar el perfil.");
            }
        }
        catch (Exception)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", "Ocurrió un error inesperado al validar.");
        }
        finally
        {
            estaCargando = false;
        }
    }

    private async Task ConfirmarAprobacionAsync(UsuarioListaDto usuario)
    {
        var confirmado = await Dialogo.Confirm(
            $"¿Desea aprobar la cuenta del colaborador {usuario.Nombre}?",
            "Aprobar Colaborador",
            new ConfirmOptions { OkButtonText = "Sí, aprobar", CancelButtonText = "Cancelar" });

        if (confirmado == true)
        {
            await EjecutarAprobacionAsync(usuario.Id);
        }
    }

    private async Task EjecutarAprobacionAsync(Guid id)
    {
        try
        {
            estaCargando = true;
            var exito = await AdminService.AprobarColaboradorAsync(id);
            if (exito)
            {
                Notificaciones.Notify(NotificationSeverity.Success, "Éxito", "La cuenta ha sido aprobada correctamente.");
                await CargarUsuariosAsync();
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo aprobar la cuenta.");
            }
        }
        catch (Exception)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", "Ocurrió un error inesperado al aprobar.");
        }
        finally
        {
            estaCargando = false;
        }
    }

    private async Task ConfirmarRevocacionAsync(UsuarioListaDto usuario)
    {
        var confirmado = await Dialogo.Confirm(
            $"¿Desea revocar la aprobación del colaborador {usuario.Nombre}? Esto desactivará su cuenta.",
            "Revocar Aprobación",
            new ConfirmOptions { OkButtonText = "Sí, revocar", CancelButtonText = "Cancelar" });

        if (confirmado == true)
        {
            await EjecutarRevocacionAsync(usuario.Id);
        }
    }

    private async Task EjecutarRevocacionAsync(Guid id)
    {
        try
        {
            estaCargando = true;
            var exito = await AdminService.RevocarAprobacionAsync(id);
            if (exito)
            {
                Notificaciones.Notify(NotificationSeverity.Success, "Éxito", "La aprobación ha sido revocada.");
                await CargarUsuariosAsync();
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se pudo revocar la aprobación.");
            }
        }
        catch (Exception)
        {
            Notificaciones.Notify(NotificationSeverity.Error, "Error", "Ocurrió un error inesperado al revocar.");
        }
        finally
        {
            estaCargando = false;
        }
    }
}
