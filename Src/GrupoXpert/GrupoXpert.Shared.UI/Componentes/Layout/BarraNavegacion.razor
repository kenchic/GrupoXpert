@* BarraNavegacion.razor — Top Navbar estilo LinkedIn (Web) *@
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<nav class="gx-navbar" id="gx-navbar-principal">
    <div class="gx-navbar-inner">
        @* Logo *@
        <a href="/" class="gx-navbar-logo" style="text-decoration:none;">
            <img src="images/logo.jpg" alt="GrupoXpert" />
            <span>GrupoXpert</span>
        </a>

        @* Búsqueda *@
        <div class="gx-navbar-search">
            <input type="text" placeholder="Buscar..." @bind="textoBusqueda" @bind:event="oninput" />
            <span class="material-icons search-icon">search</span>
        </div>

        @* Navegación principal *@
        <div class="gx-navbar-nav">
            <a href="/" class="gx-nav-item @(EsRutaActiva("/") ? "active" : "")">
                <span class="material-icons">home</span>
                <span>Inicio</span>
            </a>

           @*  <a href="/academia" class="gx-nav-item @(EsRutaActiva("/academia") ? "active" : "")">
                <span class="material-icons">school</span>
                <span>Academia</span>
            </a>

            <a href="/inscripciones" class="gx-nav-item @(EsRutaActiva("/inscripciones") ? "active" : "")">
                <span class="material-icons">assignment_ind</span>
                <span>Inscripciones</span>
            </a> *@

            <AuthorizeView Roles="Estudiante">
                <Authorized>
                    <a href="/solicitud-academica/nueva" class="gx-nav-item @(EsRutaActiva("/solicitud-academica/nueva") ? "active" : "")">
                        <span class="material-icons">add_circle_outline</span>
                        <span>Nueva Solicitud</span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <a href="/admin/gestion-usuarios" class="gx-nav-item @(EsRutaActiva("/admin") ? "active" : "")">
                        <span class="material-icons">manage_accounts</span>
                        <span>Gestión</span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Asesor,Administrador">
                <Authorized>
                    <a href="/dashboard/colaborador" class="gx-nav-item @(EsRutaActiva("/dashboard") ? "active" : "")">
                        <span class="material-icons">dashboard</span>
                        <span>Mi Panel</span>
                    </a>
                </Authorized>
            </AuthorizeView>

            <a class="gx-nav-item">
                <span class="material-icons">notifications</span>
                <span>Avisos</span>
                @if (contadorNotificaciones > 0)
                {
                    <span class="gx-nav-badge">@contadorNotificaciones</span>
                }
            </a>
        </div>

        @* Perfil *@
        <div class="gx-navbar-profile">
            <RadzenProfileMenu Style="background: transparent; border: none; box-shadow: none; padding: 0;">
                <Template>
                    <div class="gx-nav-profile-trigger">
                        @if (tieneImagen)
                        {
                            <img class="gx-nav-profile-avatar" src="@avatarUrl" alt="@nombreCompleto" />
                        }
                        else
                        {
                            <div class="gx-nav-profile-avatar-initials">@iniciales</div>
                        }
                        <span class="material-icons gx-nav-profile-caret" style="margin-left: 2px;">arrow_drop_down</span>
                    </div>
                </Template>
                <ChildContent>
                    <RadzenProfileMenuItem Text="Mi Perfil" Icon="person" Path="@perfilPath" />
                    <RadzenProfileMenuItem Text="Configuración" Icon="settings" Path="/configuracion" />
                    <RadzenProfileMenuItem Text="Cerrar Sesión" Icon="logout" Path="/api/auth/logout" />
                </ChildContent>
            </RadzenProfileMenu>
        </div>
    </div>
</nav>

@code {
    private string textoBusqueda = "";
    private int contadorNotificaciones = 3;

    private string nombreCompleto = "Usuario GrupoXpert";
    private string rol = "Estudiante";
    private string avatarUrl = "";
    private string iniciales = "GX";
    private bool tieneImagen = false;
    private string perfilPath = "/perfil";

    [Inject] private NavigationManager Navegacion { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var nombreClaim = user.FindFirst("nombre")?.Value ?? user.Identity.Name;
                if (!string.IsNullOrEmpty(nombreClaim))
                {
                    nombreCompleto = nombreClaim;
                }

                var rolClaim = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (!string.IsNullOrEmpty(rolClaim))
                {
                    rol = rolClaim;
                }
                perfilPath = (rol == "Asesor" || rol == "Colaborador") ? "/perfil-colaborador" : "/perfil";

                var imagenClaim = user.FindFirst("imagen")?.Value;
                if (!string.IsNullOrEmpty(imagenClaim))
                {
                    avatarUrl = imagenClaim;
                    tieneImagen = true;
                }
                else
                {
                    tieneImagen = false;
                    avatarUrl = "";
                }
            }
        }
        catch
        {
            tieneImagen = !string.IsNullOrEmpty(avatarUrl);
        }

        iniciales = ObtenerIniciales(nombreCompleto);
    }

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "GX";

        var parts = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "GX";

        if (parts.Length == 1)
        {
            return parts[0].Length >= 2 
                ? parts[0].Substring(0, 2).ToUpper() 
                : parts[0].ToUpper();
        }

        if (parts.Length == 2)
        {
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }

        // Si tiene 3 o más partes, se omite el segundo nombre (parte 1) y se usa la primera y la tercera parte.
        return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[2][0])}";
    }

    private bool EsRutaActiva(string ruta)
    {
        var rutaActual = new Uri(Navegacion.Uri).AbsolutePath;
        if (ruta == "/") return rutaActual == "/";
        return rutaActual.StartsWith(ruta, StringComparison.OrdinalIgnoreCase);
    }
}
