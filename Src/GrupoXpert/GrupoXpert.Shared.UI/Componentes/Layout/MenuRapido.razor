@* MenuRapido.razor — Menú lateral de accesos rápidos estilo LinkedIn *@

<div class="gx-card" id="gx-menu-rapido">
    <div style="padding:8px 0;">
        @foreach (var item in elementos.Where(e => EsVisible(e, RolUsuario)))
        {
            <a href="@item.Ruta" class="gx-quick-menu-item">
                <span class="material-icons">@item.Icono</span>
                <span>@item.Texto</span>
            </a>
        }
    </div>
</div>

@code {
    [Parameter] public string RolUsuario { get; set; } = "Estudiante";

    [Parameter] public List<ElementoMenu> elementos { get; set; } = new()
    {
        new("Mis Cursos", "menu_book", "/cursos", new[] { "Estudiante", "Asesor", "Administrador", "Revisor" }),
        new("Calificaciones", "grade", "/calificaciones", new[] { "Estudiante", "Asesor", "Administrador" }),
        new("Documentos", "folder_shared", "/documentos", new[] { "Estudiante", "Asesor", "Administrador", "Revisor" }),
        new("Configuración", "settings", "/configuracion", new[] { "Estudiante", "Asesor", "Administrador", "Revisor" })
    };

    private bool EsVisible(ElementoMenu item, string rol)
    {
        return item.RolesPermitidos.Contains(rol);
    }

    public record ElementoMenu(string Texto, string Icono, string Ruta, string[] RolesPermitidos);
}
