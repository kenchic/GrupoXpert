@inherits LayoutComponentBase
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

@* === TOP NAVBAR (estilo LinkedIn) === *@
<BarraNavegacion />

@* === 3-COLUMN LAYOUT === *@
<div class="gx-layout">
    @* Sidebar Izquierdo — Perfil + Menú Rápido *@
    <aside class="gx-sidebar-left">
        <TarjetaPerfil />
        <MenuRapido RolUsuario="@_rolUsuario" />
    </aside>

    @* Contenido Principal (feed / página) *@
    <main class="gx-main-content">
        @Body
    </main>

    @* Sidebar Derecho — Widgets *@
    <aside class="gx-sidebar-right">
        <PanelLateral titulo="Noticias Académicas"
                      elementos="@noticiasAcademicas"
                      enlaceVerMas="/noticias" />

        <PanelLateral titulo="Próximos Eventos"
                      elementos="@proximosEventos"
                      enlaceVerMas="/eventos" />
    </aside>
</div>

<RadzenComponents />

@code {
    private string _rolUsuario = "Estudiante";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                _rolUsuario = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Estudiante";
            }
        }
        catch { }
    }

    private List<PanelLateral.ElementoPanel> noticiasAcademicas = new()
    {
        new("Nuevos horarios de tutorías disponibles", "Hace 2 horas", "#A62677"),
        new("Inscripciones abiertas para el semestre 2026-II", "Hace 5 horas", "#4A76B2"),
        new("Actualización del reglamento académico", "Ayer", "#6B2D5C")
    };

    private List<PanelLateral.ElementoPanel> proximosEventos = new()
    {
        new("Semana de exámenes parciales", "12 - 16 Mayo 2026", "#4A76B2"),
        new("Feria de empleo virtual", "20 Mayo 2026", "#A62677")
    };
}
