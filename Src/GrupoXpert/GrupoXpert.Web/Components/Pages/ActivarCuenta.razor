@page "/activar-cuenta"
@using GrupoXpert.Shared.UI.Abstracciones
@inject IAutenticacionService AuthService
@inject NotificationService Notificaciones
@inject NavigationManager Navegador

<PageTitle>Activación de Cuenta - GrupoXpert</PageTitle>

<RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Style="min-height: 80vh;">
    <RadzenCard Style="max-width: 500px; padding: 3rem; text-align: center;">
        @if (procesando)
        {
            <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">Procesando activación...</RadzenText>
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" class="rz-mx-auto" />
        }
        else if (exito)
        {
            <RadzenIcon Icon="check_circle" Style="font-size: 5rem; color: var(--rz-success);" />
            <RadzenText TextStyle="TextStyle.H4" class="rz-my-4">¡Cuenta Activada!</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-6">
                Tu cuenta ha sido activada correctamente. Ya puedes acceder a todas las funcionalidades de GrupoXpert.
            </RadzenText>
            <RadzenButton Text="Ir al Inicio de Sesión" ButtonStyle="ButtonStyle.Primary" Click="@(() => Navegador.NavigateTo("/login"))" />
        }
        else
        {
            <RadzenIcon Icon="error" Style="font-size: 5rem; color: var(--rz-danger);" />
            <RadzenText TextStyle="TextStyle.H4" class="rz-my-4">Error de Activación</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-6" Style="color: var(--rz-danger);">
                @mensajeError
            </RadzenText>
            <RadzenButton Text="Volver al Registro" ButtonStyle="ButtonStyle.Light" Click="@(() => Navegador.NavigateTo("/registro"))" />
        }
    </RadzenCard>
</RadzenStack>

@code {
    [Parameter, SupplyParameterFromQuery] public string? token { get; set; }

    private bool procesando = true;
    private bool exito = false;
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(token))
        {
            procesando = false;
            mensajeError = "El token de activación no fue proporcionado.";
            return;
        }

        try
        {
            await AuthService.ActivarCuentaAsync(token);
            exito = true;
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }
}
