@page "/calificaciones"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using GrupoXpert.Shared.UI.Componentes.Calificacion

<PageTitle>Calificaciones - GrupoXpert</PageTitle>

<PanelCalificaciones EsEstudiante="@_esEstudiante" EsAdministrador="@_esAdministrador" EsAsesor="@_esAsesor" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private bool _esEstudiante = false;
    private bool _esAdministrador = false;
    private bool _esAsesor = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                _esEstudiante = role == "Estudiante";
                _esAdministrador = role == "Administrador";
                _esAsesor = role == "Asesor";
            }
        }
        catch { }
    }
}