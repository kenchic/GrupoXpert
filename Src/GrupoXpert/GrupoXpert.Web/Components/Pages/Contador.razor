@page "/contador"
@rendermode InteractiveServer

<PageTitle>Contador - GrupoXpert</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="1rem">
    <RadzenText TextStyle="TextStyle.H1">Contador</RadzenText>
    <RadzenText TextStyle="TextStyle.Body1">Este componente demuestra el manejo de estado reactivo.</RadzenText>

    <RadzenButton Text="Haz clic aquí" ButtonStyle="ButtonStyle.Primary" Click="@IncrementarContador" />

    <RadzenText TextStyle="TextStyle.H5">Conteo actual: @conteoActual</RadzenText>
</RadzenStack>

@code {
    private int conteoActual = 0;

    private void IncrementarContador()
    {
        conteoActual++;
    }
}
