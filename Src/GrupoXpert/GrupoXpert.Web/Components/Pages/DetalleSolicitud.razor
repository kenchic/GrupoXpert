@code {
    [Parameter]
    public Guid Id { get; set; }

    private SolicitudAcademicaDto? solicitud;
    private bool estaCargando = true;
    private string rolUsuario = "Estudiante";
    private List<UsuarioListaDto> asesoresDisponibles = new();
    private Guid? asesorSeleccionadoId;
    private bool guardando = false;
    private string mensajeError = "";
    private string mensajeExito = "";
    private Guid usuarioId = Guid.Empty;
    private PerfilColaboradorModelo? perfilColaboradorActual;
    private bool yaPostulado = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                rolUsuario = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Estudiante";
                var idClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                           ?? user.FindFirst("sub")?.Value;
                if (Guid.TryParse(idClaim, out var parsedId))
                {
                    usuarioId = parsedId;
                }
            }
            
            // Cargar detalle de solicitud
            solicitud = await SolicitudService.ObtenerPorIdAsync(Id);

            // Cargar perfil de colaborador si es asesor
            if (rolUsuario == "Asesor" && usuarioId != Guid.Empty)
            {
                perfilColaboradorActual = await PerfilColaboradorService.ObtenerPerfilColaboradorAsync(usuarioId);
                if (solicitud != null && perfilColaboradorActual != null)
                {
                    yaPostulado = solicitud.Postulaciones.Any(x => x.ColaboradorId == perfilColaboradorActual.Id);
                }
            }

            // Cargar asesores si el usuario es Admin y la solicitud está Pendiente
            if (rolUsuario == "Administrador" && solicitud?.Estado == 1)
            {
                var resultadoAdmins = await AdminService.ObtenerUsuariosPaginadoAsync(tipo: 2, estaAprobado: true, tamanoPagina: 100);
                if (resultadoAdmins != null)
                {
                    asesoresDisponibles = resultadoAdmins.Elementos.ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar detalle de solicitud: {ex.Message}");
            mensajeError = "No se pudieron cargar los detalles de la solicitud.";
        }
        finally
        {
            estaCargando = false;
        }
    }

    private async Task CargarSolicitud()
    {
        try
        {
            solicitud = await SolicitudService.ObtenerPorIdAsync(Id);
        }
        catch
        {
            // silencioso
        }
    }

    private async Task GuardarAsignacion()
    {
        if (asesorSeleccionadoId == null || asesorSeleccionadoId == Guid.Empty)
        {
            mensajeError = "Por favor seleccione un asesor.";
            Notificaciones.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Selección requerida",
                Detail = mensajeError,
                Duration = 4000
            });
            return;
        }

        guardando = true;
        mensajeError = "";
        mensajeExito = "";

        try
        {
            // Obtener el perfil del colaborador para tener su Id real de PerfilColaborador
            var perfil = await PerfilColaboradorService.ObtenerPerfilColaboradorAsync(asesorSeleccionadoId.Value);
            if (perfil == null)
            {
                mensajeError = "No se encontró el perfil profesional del asesor seleccionado.";
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error de Perfil",
                    Detail = mensajeError,
                    Duration = 5000
                });
                return;
            }

            var exito = await SolicitudService.AsignarAsesorAsync(Id, perfil.Id);
            if (exito)
            {
                mensajeExito = "¡Asesor asignado y notificado exitosamente!";
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Asignación Exitosa",
                    Detail = mensajeExito,
                    Duration = 4000
                });
                
                // Recargar solicitud para actualizar estado y nombre del asesor en UI
                solicitud = await SolicitudService.ObtenerPorIdAsync(Id);
            }
            else
            {
                mensajeError = "Ocurrió un error en el servidor al intentar asignar el asesor.";
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error de Servidor",
                    Detail = mensajeError,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
            Notificaciones.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Inesperado",
                Detail = mensajeError,
                Duration = 5000
            });
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Postularme()
    {
        if (perfilColaboradorActual == null)
        {
            mensajeError = "No se pudo obtener tu perfil profesional. Por favor, completa tu perfil antes de postularte.";
            Notificaciones.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Perfil Incompleto",
                Detail = mensajeError,
                Duration = 5000
            });
            return;
        }

        guardando = true;
        mensajeError = "";
        mensajeExito = "";

        try
        {
            var exito = await SolicitudService.PostularASolicitudAsync(Id, perfilColaboradorActual.Id);
            if (exito)
            {
                mensajeExito = "¡Te has postulado exitosamente! Tu perfil está bajo revisión de la administración.";
                yaPostulado = true;
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Postulación Exitosa",
                    Detail = mensajeExito,
                    Duration = 5000
                });
                
                // Recargar solicitud para actualizar la lista de postulaciones en UI
                solicitud = await SolicitudService.ObtenerPorIdAsync(Id);
            }
            else
            {
                mensajeError = "Ocurrió un error en el servidor al intentar postularte.";
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error al Postular",
                    Detail = mensajeError,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
            Notificaciones.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Inesperado",
                Detail = mensajeError,
                Duration = 5000
            });
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task AceptarPostulacion(Guid colaboradorId)
    {
        guardando = true;
        mensajeError = "";
        mensajeExito = "";

        try
        {
            var exito = await SolicitudService.SeleccionarPostuladoAsync(Id, colaboradorId);
            if (exito)
            {
                mensajeExito = "¡Asesor seleccionado y asignado exitosamente al proyecto!";
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Asignación Exitosa",
                    Detail = mensajeExito,
                    Duration = 5000
                });
                
                // Recargar solicitud para actualizar estado y nombre del asesor en UI
                solicitud = await SolicitudService.ObtenerPorIdAsync(Id);
            }
            else
            {
                mensajeError = "Ocurrió un error en el servidor al intentar aceptar la postulación.";
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error de Servidor",
                    Detail = mensajeError,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
            Notificaciones.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Inesperado",
                Detail = mensajeError,
                Duration = 5000
            });
        }
        finally
        {
            guardando = false;
        }
    }

    private string ObtenerInicialesNombre(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "CO";
        var parts = nombre.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "CO";
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
        return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[parts.Length - 1][0])}";
    }

    // UTILITIES DE DISEÑO COMPARTIDOS
    private string ObtenerBordePorEstado(int estado) => estado switch
    {
        1 => "#d97706", // Pendiente: Amber
        2 => "#4a76b2", // En Proceso: Azul
        3 => "#26b050", // Completada: Verde
        4 => "#9ca3af", // Cancelada: Gris
        5 => "#7c3aed", // Asignada: Violeta
        _ => "#e5e7eb"
    };

    private string ObtenerFondoEstado(int estado) => estado switch
    {
        1 => "rgba(245, 158, 11, 0.08)",
