@page "/error"
@using Microsoft.AspNetCore.Diagnostics
@rendermode InteractiveServer

<PageTitle>Error - GrupoXpert</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem;">
    <RadzenIcon Icon="error" Style="font-size: 4rem; color: var(--color-primario);" />
    <RadzenText TextStyle="TextStyle.H1" Style="color: var(--color-primario);">Error</RadzenText>
    <RadzenText TextStyle="TextStyle.H5">Ocurrió un error inesperado.</RadzenText>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <RadzenCard Style="background-color: #ffebee; border-left: 4px solid var(--color-primario); max-width: 600px;">
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle2">Detalles del error:</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@mensajeError</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
    else if (MostrarDetallesDesarrollo)
    {
        <RadzenCard Style="background-color: #fff3e0; border-left: 4px solid #ff9800; max-width: 600px;">
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle2">Modo Desarrollo:</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">
                    Se han detectado errores de desarrollo. Revisa los detalles para corregirlos.
                </RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
                    @foreach (var detalle in detallesDesarrollo)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@detalle.Tipo" />
                        <RadzenText TextStyle="TextStyle.Body2">@detalle.Mensaje</RadzenText>
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Center">
            Por favor, intenta nuevamente más tarde. Si el problema persiste, contacta al soporte técnico.
        </RadzenText>
    }

    <RadzenButton Text="Volver al Inicio" ButtonStyle="ButtonStyle.Primary" Path="/" Icon="home" />
</RadzenStack>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? mensajeError;
    private bool MostrarDetallesDesarrollo;
    private List<DetalleError> detallesDesarrollo = new();

    protected override void OnInitialized()
    {
        var excepcion = HttpContext?.Features.Get<IExceptionHandlerFeature>()?.Error;
        if (excepcion != null)
        {
            mensajeError = excepcion.Message;
        }

        var env = HttpContext?.RequestServices.GetRequiredService<IHostEnvironment>();
        MostrarDetallesDesarrollo = env?.IsDevelopment() ?? false;

        if (MostrarDetallesDesarrollo)
        {
            detallesDesarrollo.Add(new DetalleError("Desarrollo", "Los detalles de error se muestran solo en modo desarrollo."));
        }
    }

    private record DetalleError(string Tipo, string Mensaje);
}
