@page "/"
@rendermode InteractiveServer

<PageTitle>Inicio - GrupoXpert</PageTitle>

@* === Banner de bienvenida (como el hero de LinkedIn) === *@
<div class="gx-card" style="background: var(--navbar-bg); color: white; border-radius: var(--card-radius); overflow: hidden;">
    <div style="padding: 24px 28px; position: relative;">
        <span class="material-icons" style="font-size: 6rem; opacity: 0.08; position: absolute; right: 16px; bottom: -8px;">dashboard</span>
        <h1 style="font-size: 1.5rem; font-weight: 800; margin: 0 0 6px;">¡Bienvenido a GrupoXpert!</h1>
        <p style="font-size: 0.9rem; opacity: 0.9; margin: 0;">Plataforma Integral de Gestión Académica y Profesional</p>
    </div>
</div>

@* === Accesos rápidos (cards horizontales) === *@
<div style="display: flex; gap: 12px; overflow-x: auto; padding: 4px 0;">
    <div class="gx-card" style="flex: 1; min-width: 180px; cursor: pointer;">
        <div class="gx-card-body" style="display: flex; align-items: center; gap: 12px;">
            <span class="material-icons" style="font-size: 2rem; color: var(--color-primario);">people</span>
            <div>
                <div style="font-weight: 600; font-size: 0.88rem;">Gestión de Usuarios</div>
                <div style="font-size: 0.75rem; color: var(--text-secondary);">Administrar perfiles</div>
            </div>
        </div>
    </div>
    <div class="gx-card" style="flex: 1; min-width: 180px; cursor: pointer;">
        <div class="gx-card-body" style="display: flex; align-items: center; gap: 12px;">
            <span class="material-icons" style="font-size: 2rem; color: var(--color-secundario);">school</span>
            <div>
                <div style="font-weight: 600; font-size: 0.88rem;">Grados y Cursos</div>
                <div style="font-size: 0.75rem; color: var(--text-secondary);">Oferta académica</div>
            </div>
        </div>
    </div>
    <div class="gx-card" style="flex: 1; min-width: 180px; cursor: pointer;">
        <div class="gx-card-body" style="display: flex; align-items: center; gap: 12px;">
            <span class="material-icons" style="font-size: 2rem; color: #f97316;">assignment</span>
            <div>
                <div style="font-weight: 600; font-size: 0.88rem;">Reportes</div>
                <div style="font-size: 0.75rem; color: var(--text-secondary);">Informes y métricas</div>
            </div>
        </div>
    </div>
</div>

@* === Feed de actividades (estilo LinkedIn) === *@
<TarjetaFeed identificador="act-1"
             autor="Departamento Académico"
             subtitulo="Administración"
             tiempo="Hace 2 horas"
             avatarUrl="images/logo.jpg">
    <ContenidoHijo>
        <p style="margin:0;">📚 <strong>Nuevos horarios de tutorías</strong> disponibles para el semestre 2026-II. Consulta los horarios actualizados en la sección de Academia.</p>
    </ContenidoHijo>
</TarjetaFeed>

<TarjetaFeed identificador="act-2"
             autor="Coordinación de Grados"
             subtitulo="Gestión Académica"
             tiempo="Hace 5 horas"
             avatarUrl="images/logo.jpg">
    <ContenidoHijo>
        <p style="margin:0;">🎓 Las <strong>inscripciones</strong> para el periodo 2026-II están abiertas. No olvides verificar tu documentación antes de la fecha límite del <em>30 de mayo</em>.</p>
    </ContenidoHijo>
</TarjetaFeed>

<TarjetaFeed identificador="act-3"
             autor="Dirección General"
             subtitulo="Comunicado Institucional"
             tiempo="Ayer"
             avatarUrl="images/logo.jpg">
    <ContenidoHijo>
        <p style="margin:0;">📋 Se ha actualizado el <strong>reglamento académico</strong> para el periodo vigente. Revisa los cambios en la sección de documentos institucionales.</p>
    </ContenidoHijo>
</TarjetaFeed>

@code {
    // Aquí implementaremos la lógica de carga de feed real más adelante
}
