@page "/login"
@rendermode InteractiveServer
@layout GrupoXpert.Web.Components.Layout.LoginLayout
@using GrupoXpert.Shared.UI.Abstracciones
@inject NavigationManager Navegador
@inject NotificationService Notificaciones
@inject IJSRuntime JS
@inject IAutenticacionService AuthService

<PageTitle>Iniciar Sesión - GrupoXpert</PageTitle>

<div class="rz-p-4 rz-p-md-12" style="height: 100%; display: flex; align-items: center; justify-content: center; background-color: var(--color-fondo);">
    <FormularioLogin AlIniciarSesion="@ManejarLogin" />
</div>

@* Formulario oculto que el navegador envía directamente al servidor para establecer la cookie *@
<form id="cookieForm" method="post" action="/api/auth/cookie-login" style="display:none;">
    <input type="hidden" name="jwt" id="jwtInput" />
</form>

@code {
    private async Task ManejarLogin(FormularioLogin.LoginModelo modelo)
    {
        try 
        {
            // 1. Obtener el JWT desde la API de backend
            var token = await AuthService.IniciarSesionAsync(modelo.Correo, modelo.Clave);

            if (!string.IsNullOrEmpty(token))
            {
                Notificaciones.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Acceso Correcto",
                    Detail = "Bienvenido al sistema.",
                    Duration = 2000
                });

                // 2. Enviar el JWT al endpoint de cookie vía formulario HTML del NAVEGADOR
                //    Esto garantiza que la cookie Set-Cookie se establece en el browser
                await JS.InvokeVoidAsync("eval", 
                    $"document.getElementById('jwtInput').value = '{token}'; document.getElementById('cookieForm').submit();");
            }
            else
            {
                Notificaciones.Notify(NotificationSeverity.Error, "Error", "No se recibió un token válido.");
            }
        }
        catch (Exception ex)
        {
            Notificaciones.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error de Acceso",
                Detail = ex.Message,
                Duration = 4000
            });
        }
    }
}
