@using GrupoXpert.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1" Style="@($"background:{Colors.Purple.Darken3};")">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" Color="Color.Inherit" OnClick="@ToggleDrawer" />
                <MudSpacer />
                <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Link="https://github.com/MudBlazor/MudBlazor" Target="_blank" />
            </MudAppBar>

            <MudDrawer @bind-Open="@abrirMenu"
                       Elevation="1"
                       Style="@($"background-image: linear-gradient(to bottom, {Colors.Purple.Darken3}, {Colors.Purple.Darken2}, {Colors.Purple.Darken1}, {Colors.Purple.Lighten1});")">
                <MudDrawerHeader>
                    <MudText Typo="Typo.h5">Coin Control</MudText>
                </MudDrawerHeader>
                <MudNavMenu Style="color: white">
                    <MudNavLink Match="NavLinkMatch.All" Href="" Icon="@Icons.Material.Filled.Home">Dashboard 1</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Href="/dash2" Icon="@Icons.Material.Filled.Home">Dashboard 2</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Href="/dash3" Icon="@Icons.Material.Filled.Home">Dashboard 3</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" OnClick="@OnLogout" Icon="@Icons.Material.Filled.Logout">Salir</MudNavLink>
                </MudNavMenu>
            </MudDrawer>

            <MudMainContent Class="pt-16 px-5">
                <MudContainer Class="mt-3">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <Autenticar OnAutenticar="@OnAutenticar" />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Inject]
    private AuthenticationStateProvider? AuthenticationStateProvider { get; set; }

    [Inject]
    private NavigationManager NavManager { get; set; }

    bool abrirMenu = true;

    private async Task OnAutenticar(AutenticarEventArgs e)
    {
        AuthorizationRequest authRequest = new AuthorizationRequest()
            {
                UserName = e.Usuario,
                Password = e.Clave
            };
        AuthorizationResponse auth = new GrupoXpert.Client.AuthenticationService().LoginDummy(authRequest);
        if (auth != null)
        {
            await ((CustomAuthenticationStateProvider)AuthenticationStateProvider!).UpdateAuthenticationState(authRequest.UserName, auth.Token);
            NavManager.NavigateTo("/", true);
        }
    }

    private void ToggleDrawer()
    {
        abrirMenu = !abrirMenu;
    }

    private async Task OnLogout()
    {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider!).UpdateAuthenticationState(null, null);
    }
}